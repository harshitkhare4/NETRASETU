# NetraSetu Environment Configuration Template
# Copy this file to .env and configure local environment variables

# Flask Application Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Research Pipeline Mode
# false = Production Mode (strictly APTOS ResNet-50 baseline, 0.24 threshold)
# true  = Research Mode (enables multi-modal explainability, calibration, localization, lesion/vessel segmentation)
NETRASETU_RESEARCH_MODE=false

# Model Checkpoint Path (Deployment / Mount Location)
NETRASETU_MODEL_PATH=models/NetraSetu_ResNet50_best.pth
